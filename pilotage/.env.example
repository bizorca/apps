# Pilotage — environment
# Copy to .env. NEVER commit .env (house rule: server-side only).

# 32 random bytes, base64. Encrypts OAuth refresh tokens at rest.
#   php -r 'echo base64_encode(random_bytes(32));'
# Without it, calendar sync does not offer itself at all — there would be
# nowhere safe to put the tokens.
APP_SECRET_KEY=

APP_ENV=development
APP_DEBUG=true
FORCE_HTTPS=false

# Three domains, three jobs (spec §7).
#   BASE_DOMAIN      product, tenant subdomains, and ALL outbound mail
#   MARKETING_DOMAIN spoken CTA, 301 to the marketing site — never product links
#   SHORT_DOMAIN     SMS short links only — deliberately not the sending domain
# Production: pilotagehq.com / getpilotage.com / pilotage.cc
BASE_DOMAIN=pilotage.test
MARKETING_DOMAIN=getpilotage.com
SHORT_DOMAIN=pilotage.cc

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=pilotage_dev
DB_USER=root
DB_PASS=

# Separate schema for the isolation suite — tests truncate tables.
TEST_DB_NAME=pilotage_test

# Public intake: which firm receives enquiries arriving at the bare apex
# (pilotagehq.com/apply), where no tenant is in scope. Blank disables it.
INTAKE_HOUSE_TENANT=bizorca

# SMTP2GO (HTTP API). Leave the key blank in development and mail is written
# to storage/mail.log instead of being sent.
SMTP2GO_API_KEY=
MAIL_FROM=notifications@pilotagehq.com
MAIL_FROM_NAME=Pilotage

# Stripe (M13). The FIRM is the customer; client organizations are never billed
# by the platform. Leave the key blank and billing is simply not configured —
# every screen renders, nothing is enforced, and development needs no account.
#
# BILLING_ENFORCE is deliberately separate from having a key: wiring Stripe up
# and turning on the read-only gate are two decisions, and doing both at once is
# how a live tenant gets locked out by accident. Set it only once checkout has
# been walked end to end in test mode.
# Free during beta. While this is true nothing is charged and nothing is gated:
# trials never expire, the read-only gate never fires, and the billing screen
# says so instead of showing buy buttons. Turning it off is what starts charging
# people — do that first, then wire Stripe, then BILLING_ENFORCE=true.
BILLING_BETA=true

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
BILLING_ENFORCE=false

# Price IDs from the Stripe dashboard. Test-mode and live-mode IDs differ.
STRIPE_PRICE_SOLO_MONTH=
STRIPE_PRICE_SOLO_YEAR=
STRIPE_PRICE_PRACTICE_MONTH=
STRIPE_PRICE_PRACTICE_YEAR=
STRIPE_PRICE_FIRM_MONTH=
STRIPE_PRICE_FIRM_YEAR=

# Two-way calendar sync (Phase 3). A provider with no client id is simply not
# offered, so leaving these blank is a valid configuration.
#
# Google:    console.cloud.google.com -> APIs & Services -> Credentials
#            Authorised redirect URI: https://<tenant>.pilotagehq.com/calendar/callback/google
#            Scopes: calendar.events, userinfo.email
# Microsoft: portal.azure.com -> App registrations
#            Redirect URI: https://<tenant>.pilotagehq.com/calendar/callback/microsoft
#            Scopes: offline_access, openid, email, Calendars.ReadWrite
#
# Note both providers require the redirect URI to match EXACTLY, and tenant
# subdomains mean one entry per firm unless a wildcard is configured. See
# docs/calendar-sync.md.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
